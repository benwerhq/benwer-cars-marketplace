# Browser-facing API base. Prefer the same-origin BFF:
#   /api/:path*  →  $API_ORIGIN/:path*  (src/app/api/[...path]/route.ts)
# openapi-fetch concatenates baseUrl + "/v1/public/...", so this:
#   NEXT_PUBLIC_API_URL=https://cars-api.benwer.es/v1
# becomes GET https://cars-api.benwer.es/v1/v1/public/companies (404)
# and the client used to fall back to mock cars (wrong images / v-med-1 ids).
#
# Right:
#   Local browser: http://localhost:3002/api
#   Production:    https://cars-api.benwer.es  (browser still uses /api when
#                  this host is cross-origin; the BFF calls API_ORIGIN)
# Confirm: curl -s "$API_ORIGIN/v1/public/companies"
# Local needs benwer-cars-api + seed. The marketplace will not fake catalogue
# data if this URL or the API is missing.
NEXT_PUBLIC_API_URL=http://localhost:3002/api

# Server-side origin (Server Components + /api BFF). Same rule: no /v1 suffix.
# Local API: http://localhost:8080
# Production: https://cars-api.benwer.es
# Confirm with: curl -s http://localhost:8080/health
# Confirm public: curl -s http://localhost:8080/v1/public/companies
API_ORIGIN=http://localhost:8080

# LocalStack S3 (seed photos). Marketplace rewrites /localstack/:path* here.
LOCALSTACK_ORIGIN=http://localhost:4566

# Optional public CDN/S3 origin used to turn bare object keys into image
# URLs. When unset, keys without http(s) stay empty and the UI shows the
# photo empty-state (never a mock Corolla/SUV/Tesla jpg).
# NEXT_PUBLIC_MEDIA_ORIGIN=https://dxxxx.cloudfront.net

# Google Maps for the /companies map (Maps JavaScript API). Restrict the key
# to the marketplace HTTP referrers in Google Cloud. The Map ID is a vector
# map with light + dark styles; without it the dev-only DEMO_MAP_ID is used.
# When the key is unset the map falls back to Leaflet + Esri tiles.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_MARKETPLACE_DOMAIN=benwer.es
# Optional extra marketplace hosts (csv, no scheme). The host of
# NEXT_PUBLIC_APP_URL is always treated as a marketplace front door.
# Staging: NEXT_PUBLIC_MARKETPLACE_DOMAIN=staging.benwer.es
#          NEXT_PUBLIC_APP_URL=https://staging.cars-marketplace.benwer.es
# NEXT_PUBLIC_PLATFORM_HOSTS=staging.cars-marketplace.benwer.es
# local | staging | production
# Production Vercel MUST be production (or unset: NODE_ENV=production now
# defaults this to production). "local" does not enable mock catalogue data.
# Ask guests for pick-up/return time, flight number, comments and date of
# birth, and let them edit their details on the profile page. Keep "false"
# until the API stores these fields (benwer-cars-api guest booking fields).
NEXT_PUBLIC_GUEST_BOOKING_FIELDS=false
NEXT_PUBLIC_ENV=local

# Marketing / plans checkout (landing page). When unset the default follows
# NEXT_PUBLIC_ENV: production https://cars.benwer.es, staging
# https://staging.cars.benwer.es, local http://localhost:3000.
# NEXT_PUBLIC_MARKETING_URL=https://cars.benwer.es

# Optional live admin demo. When unset, the homepage partners section hides the
# secondary "View live demo" button.
# NEXT_PUBLIC_ADMIN_DEMO_URL=https://admin.cars.benwer.es

# Benwer Cars support WhatsApp (digits, country code first; spaces and +
# allowed). Same number as the landing page. When unset, the support button
# only offers the contact form.
# NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=34600000000

# Staff admin origin for "Edit on my site" links from a preview (?preview=&edit=1).
# When unset the default follows NEXT_PUBLIC_ENV: production
# https://cars-admin.benwer.es, staging https://staging.cars-admin.benwer.es,
# local http://localhost:3001. Never point a staging build at production.
# NEXT_PUBLIC_ADMIN_URL=https://staging.cars-admin.benwer.es

# Staff Firebase for owner edit mode on the tenant site (same project as admin).
# Never reuse guest Firebase here.
# NEXT_PUBLIC_STAFF_FIREBASE_API_KEY=
# NEXT_PUBLIC_STAFF_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_STAFF_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_STAFF_FIREBASE_APP_ID=
# NEXT_PUBLIC_STAFF_FIREBASE_TENANT_ID=

# Guest Firebase (separate from staff). When unset, the tenant site shows a
# friendly disabled state instead of guest sign-in.
# NEXT_PUBLIC_GUEST_FIREBASE_API_KEY=
# NEXT_PUBLIC_GUEST_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_GUEST_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_GUEST_FIREBASE_APP_ID=
# NEXT_PUBLIC_GUEST_FIREBASE_TENANT_ID=
